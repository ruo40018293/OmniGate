# omnigate 容器部署环境变量模板
#
# 用法：
#   cp .env.example .env   然后把下面两个 ★必改 项换成你自己的强随机值。
#
# Docker Compose 会**自动加载同目录下的 .env 文件**，无需在 compose 里写 env_file。
# docker-compose.yml 里形如 "${WILDWORK_API_KEY:-...}" 的占位符就取自这里。
#
# ⚠️ 本文件**不要**直接当 .env 用：里面是占位符，不是真密钥。
# ⚠️ .env 含明文密钥，仓库 .gitignore 已显式忽略 docker/.env 与 .env。
#    但请在 commit 前用 `git status` 再确认一次 —— 密钥一旦进了公开仓库的
#    历史提交，事后删除也挖得回来，只能视为已泄露并立即轮换。

# ─────────────────────────────────────────────────────────────────
# ★必改 项
# ─────────────────────────────────────────────────────────────────

# Web 面板登录口令。
#   留空 + 对外监听（非环回）= 程序**直接拒绝启动**，这是有意的：
#   防止有人把容器端口映射到公网却忘了设密码。
#   生成：head -c 18 /dev/urandom | base64 | tr -d '/+='
WILDWORK_ADMIN_PASSWORD=CHANGE_ME_admin_pass

# OpenAI 兼容接口的 Bearer 密钥。
#   留空 = 接口不鉴权，任何能访问该端口的人都能消耗你的账号额度。
#   生成：head -c 32 /dev/urandom | base64 | tr -d '/+='
WILDWORK_API_KEY=CHANGE_ME_strong_api_key

# ─────────────────────────────────────────────────────────────────
# 以下均可省略，注释即默认值
# ─────────────────────────────────────────────────────────────────

# 监听地址。容器内**必须**是 ":7863"（全部网卡），
# 写成 "127.0.0.1:7863" 会导致宿主访问不到。
# WILDWORK_LISTEN=":7863"

# 区域：cn（国内版）或 global。默认 cn。
# WILDWORK_REGION="cn"

# 账号目录与状态文件（容器内路径，对应 volumes 挂载点）。
# WILDWORK_AUTH_DIR="/data/auths"
# WILDWORK_STATE_FILE="/data/state.json"

# 账号挑选策略：expire（临期优先）/ credits（优先积分）/ roundrobin（负载均衡）。
# 默认 expire。
# WILDWORK_STRATEGY="expire"

# 单次请求最多轮换多少个账号。默认 3，上限 20。
#   账号多且大量处于冷却时，调大可减少「本可成功却被判 503」的情况；
#   代价是单请求最多触发这么多次上游往返。设 >20 会被钳到 20。
# WILDWORK_MAX_ROTATE="3"

# ── 冷却策略 ──────────────────────────────────────────────────
# 余额/权益不足 → 整号冷却多久
# WILDWORK_HARD_CREDIT="12h"
# 被限流 → 软冷却多久
# WILDWORK_SOFT_RATE="60s"
# 连续错误几次进入冷却
# WILDWORK_ERR_THRESHOLD="3"
# 错误冷却时长
# WILDWORK_ERR_COOLDOWN="10m"

# 上游单次请求超时（秒）
# WILDWORK_TIMEOUT_SECONDS="120"

# ── 三协议兼容层 ──────────────────────────────────────────────
# 不带渠道前缀的模型名走哪个渠道
# WILDWORK_DEFAULT_CHANNEL="workbuddy"
# max_tokens 上限，0 = 不限制
# WILDWORK_MAX_TOKENS_CAP="32000"

# ─────────────────────────────────────────────────────────────────
# 尚未支持 env 覆盖的配置项（只能改 config.json / 面板）
# ─────────────────────────────────────────────────────────────────
#
# 代理（单渠道上游代理，key 为渠道名，值为 scheme://host:port）：
#   {
#     "proxies": {
#       "workbuddy": "socks5://host.docker.internal:7897"
#     }
#   }
# ⚠️ 走宿主代理时 host 必须填**宿主在 docker 网络里的可达地址**
#    （如 host.docker.internal:7897），不能填 127.0.0.1 ——
#    容器内的 127.0.0.1 指向容器自己，会静默连不通。
#
# 成长中心自动化（默认全关；开启会**真实改变账号状态**，
# 抽奖次数用掉不可撤销，故必须由用户显式开启）：
#   {
#     "schedule": {
#       "growth_redeem_streak": true,      // 连登档位自动兑换 + 抽奖抽完
#       "growth_travel": true,             // 猫猫旅行自动派出 + 到站领取
#       "growth_travel_location": 1        // 目的地 1~4
#     }
#   }